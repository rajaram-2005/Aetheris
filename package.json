{
  "name": "aetheris",
  "version": "2026.9.1",
  "private": false,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "eval": "tsx evals/run.ts",
    "verify:connectors": "tsx scripts/verify-connectors.ts",
    "desktop:dev": "node desktop/scripts/dev.mjs",
    "desktop:typecheck": "npm --prefix desktop run typecheck",
    "desktop:build": "node tools/desktop-build.mjs",
    "desktop:prepare": "node desktop/scripts/prepare-app.mjs",
    "desktop:pack": "cd desktop && npm run compile && electron-builder --dir",
    "desktop:dist": "cd desktop && npm run dist",
    "version:bump": "tsx tools/bump-version.mjs",
    "version:show": "tsx -e \"import('./tools/bump-version.mjs').then(m=>console.log(m.readVersion()))\"",
    "changelog": "tsx tools/changelog.mjs",
    "release": "bash tools/release.sh",
    "icons": "node tools/gen-icons.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "jsdom": "^30.0.1",
    "next": "^15.5.0",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "sharp": "^0.33.5",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "description": "Aetheris One — open-source AI workspace: one chat over 27 free LLM providers, hierarchical agents, GitHub coding factory, media studio, 100+ MCP app hub.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rajaram-2005/Aetheris.git"
  },
  "homepage": "https://github.com/rajaram-2005/Aetheris#readme",
  "bugs": {
    "url": "https://github.com/rajaram-2005/Aetheris/issues"
  },
  "keywords": [
    "ai",
    "llm",
    "nextjs",
    "mcp",
    "agents",
    "openai-compatible",
    "free-llm",
    "router",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  }
}
