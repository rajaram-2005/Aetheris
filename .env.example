# --- Aetheris runtime configuration ---
# Copy to ".env" and adjust as needed. All values are optional; Aetheris runs
# out of the box with the local Hermes provider when no remote endpoint is set.

# Server bind address (the preview requires 0.0.0.0).
AETHERIS_HOST=0.0.0.0
AETHERIS_PORT=8000

# Provider:
#   "hermes" (default) — the local Hermes agent: real computation, retrieval,
#                        tools, and meta-learning. Fully offline, no API key.
#   "openai"           — forward to any OpenAI-compatible endpoint.
#   "anthropic"        — Claude via the Anthropic Messages API (requires
#                        AETHERIS_ANTHROPIC_API_KEY).
#   "gemini"           — Google Gemini generateContent (requires
#                        AETHERIS_GEMINI_API_KEY).
#   "nvidia"           — NVIDIA NIM chat/tool calling fused with Hermes
#                        meta-learning (requires AETHERIS_NVIDIA_API_KEY).
#   "neural"           — the custom sovereign neural model engine.
#   "mock"             — the legacy persona responder (kept for compatibility).
AETHERIS_LLM_PROVIDER=hermes

# --- Hermes agent + meta-learning ---
# Turn the whole unified runtime off (falls back to the mock provider).
AETHERIS_HERMES_ENABLED=true
# Record episodes and adapt. Set false for a stateless, reproducible deployment.
AETHERIS_HERMES_LEARNING_ENABLED=true
# Persist meta-learned state (strategy, episodes, exemplars, priors) across
# restarts. Empty = in-memory only, forgotten on shutdown.
AETHERIS_HERMES_META_STATE_PATH=
# Save that state automatically on shutdown when a path is set above.
AETHERIS_HERMES_META_AUTOSAVE=true
# Maximum tools the agent may invoke for one task.
AETHERIS_HERMES_MAX_TOOLS_PER_TURN=3

# --- Used only when AETHERIS_LLM_PROVIDER=openai ---
# Any OpenAI-compatible /v1/chat/completions endpoint (OpenAI, Together,
# Groq, vLLM, Ollama's OpenAI shim, LM Studio, etc.).
AETHERIS_LLM_BASE_URL=https://api.openai.com/v1
AETHERIS_LLM_API_KEY=
# Upstream model used when a request does not specify an Aetheris tier.
AETHERIS_LLM_MODEL=aetheris-prime-v4
# Per-request upstream timeout in seconds.
AETHERIS_LLM_TIMEOUT=120

# --- NVIDIA NIM (optional unified accelerator) ------------------------------
# Create a Developer API key at https://build.nvidia.com/settings/api-keys.
# Keys normally start with "nvapi-". Keep this value in your local .env only;
# never paste it into browser code or commit it. One key powers NVIDIA chat,
# code, image, and hosted video endpoints.
AETHERIS_NVIDIA_API_KEY=
# The standard process environment name NVIDIA_API_KEY is also accepted when
# AETHERIS_NVIDIA_API_KEY is empty (useful with existing NVIDIA tooling).
# OpenAI-compatible NIM endpoint and chat/tool model.
AETHERIS_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AETHERIS_NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
# Coding model used by POST /v1/code/generations and the generate_code tool.
AETHERIS_NVIDIA_CODE_MODEL=deepseek-ai/deepseek-v4-flash
AETHERIS_NVIDIA_CODE_MAX_TOKENS=8192
# Keep Hermes few-shot adaptation + cross-provider episode learning enabled.
AETHERIS_NVIDIA_META_LEARNING_ENABLED=true

# ============================================================================
# Capability flags
# ============================================================================
# Rule of thumb: capabilities contained inside the process are ON by default;
# capabilities that reach outside it are OFF until you opt in.

# --- Agentic tool use -------------------------------------------------------
# Expose the built-in toolbelt and allow the model to call tools.
AETHERIS_TOOLS_ENABLED=true
# Allow the autonomous loop (plan -> call tools -> observe -> self-correct).
AETHERIS_AGENT_ENABLED=true
# Maximum tool-calling rounds per agent request.
AETHERIS_AGENT_MAX_ITERATIONS=6
# Run EVERY chat request through the agent loop, even without "agent": true.
AETHERIS_AGENT_DEFAULT_ON=false

# --- Code sandbox (isolated subprocess Python execution) --------------------
AETHERIS_SANDBOX_ENABLED=true
AETHERIS_SANDBOX_TIMEOUT=10
AETHERIS_SANDBOX_MEMORY_MB=512
AETHERIS_SANDBOX_MAX_OUTPUT_CHARS=12000
# Let sandboxed code open sockets. Leave false unless you fully trust callers.
AETHERIS_SANDBOX_ALLOW_NETWORK=false

# --- Retrieval / RAG --------------------------------------------------------
AETHERIS_RAG_ENABLED=true
AETHERIS_RAG_CHUNK_SIZE=1200
AETHERIS_RAG_CHUNK_OVERLAP=180
AETHERIS_RAG_MAX_DOCUMENTS=200
# Optional: index every text file in this directory at startup.
AETHERIS_RAG_CORPUS_DIR=
# Auto-ground plain (non-agent) chat with the mounted corpus.
AETHERIS_RAG_AUTO_CONTEXT=true

# --- Multimodal / vision ----------------------------------------------------
AETHERIS_VISION_ENABLED=true
AETHERIS_VISION_MAX_IMAGES=8

# --- Outbound web access (OFF by default) -----------------------------------
# Enables the web_fetch tool. Requests are SSRF-guarded: private, loopback,
# link-local, and cloud-metadata addresses are always refused.
AETHERIS_WEB_ENABLED=false
AETHERIS_WEB_TIMEOUT=20
# Optional comma-separated host allowlist, e.g. "docs.python.org,arxiv.org".
AETHERIS_WEB_ALLOWED_HOSTS=

# --- Sovereign (unrestricted) mode — OFF by default -------------------------
# Exposes the "sovereign" inference mode: no reflexive hedging, no boilerplate
# disclaimers, full depth on difficult and dual-use topics, explicit positions.
# Calibrated honesty replaces hedging and fabrication remains forbidden.
# The operator who enables this accepts responsibility for its use.
AETHERIS_SOVEREIGN_ENABLED=false

# --- Creative generation ----------------------------------------------------
# Images, video, audio, and project scaffolds are synthesised in-process with
# the standard library only — no API key, no GPU, no ffmpeg.
AETHERIS_IMAGE_GENERATION_ENABLED=true
AETHERIS_VIDEO_GENERATION_ENABLED=true
AETHERIS_AUDIO_GENERATION_ENABLED=true
AETHERIS_CODE_GENERATION_ENABLED=true
# Output ceilings.
AETHERIS_MEDIA_MAX_IMAGE_DIMENSION=2048
AETHERIS_MEDIA_MAX_VIDEO_DIMENSION=960
AETHERIS_MEDIA_MAX_VIDEO_SECONDS=10
AETHERIS_MEDIA_MAX_AUDIO_SECONDS=60
# Memory budget for the in-process artifact store (MiB). Artifacts are ephemeral:
# the oldest are evicted when the budget is exceeded, and all are lost on restart.
AETHERIS_MEDIA_STORE_MAX_MB=192

# --- Image generation provider (layered) ------------------------------------
# Which engine renders images. 'offline' (default, no key) is the deterministic
# procedural renderer. 'nvidia' uses a Visual Generative AI NIM (FLUX by
# default), 'openai' uses DALL-E / gpt-image, 'gemini' uses Google Imagen 3,
# and 'stability' uses Stability AI. 'auto' prefers NVIDIA when its key exists,
# otherwise uses the first configured provider or falls back to offline.
AETHERIS_IMAGE_PROVIDER=auto
# Per-provider credentials (any one is enough for real image generation).
AETHERIS_OPENAI_IMAGE_API_KEY=
AETHERIS_OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
AETHERIS_OPENAI_IMAGE_MODEL=gpt-image-1
AETHERIS_GEMINI_IMAGE_API_KEY=
AETHERIS_GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
AETHERIS_STABILITY_API_KEY=
AETHERIS_STABILITY_MODEL=stable-image-core
# NVIDIA FLUX (uses AETHERIS_NVIDIA_API_KEY above).
AETHERIS_NVIDIA_IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.1-dev
AETHERIS_NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-dev
AETHERIS_NVIDIA_IMAGE_STEPS=30
AETHERIS_NVIDIA_IMAGE_CFG_SCALE=5.0
# On remote failure, fall back to the offline renderer so requests never 5xx.
AETHERIS_IMAGE_FALLBACK_OFFLINE=true

# --- Video generation provider (layered) ------------------------------------
# 'auto' selects NVIDIA Cosmos when AETHERIS_NVIDIA_API_KEY is present, else
# the in-process GIF renderer. NVIDIA Preview endpoint URLs can change; copy the
# current URL from the model's API tab on build.nvidia.com when necessary.
AETHERIS_VIDEO_PROVIDER=auto
AETHERIS_NVIDIA_VIDEO_BASE_URL=https://ai.api.nvidia.com/v1/cosmos/nvidia/cosmos3-nano
AETHERIS_NVIDIA_VIDEO_MODEL=nvidia/cosmos3-nano
AETHERIS_NVIDIA_VIDEO_STATUS_BASE_URL=https://api.nvcf.nvidia.com/v2/nvcf/pexec/status
AETHERIS_NVIDIA_VIDEO_STEPS=30
AETHERIS_NVIDIA_VIDEO_GUIDANCE_SCALE=6.0
AETHERIS_NVIDIA_VIDEO_TIMEOUT=600
AETHERIS_NVIDIA_VIDEO_POLL_INTERVAL=2.0
# If the hosted endpoint is unavailable, still return an offline animated GIF.
AETHERIS_VIDEO_FALLBACK_OFFLINE=true

# --- Voice (layered text-to-speech & speech-to-text) ------------------------
# Text-to-speech: 'offline' (default, no key) uses the in-process formant
# synthesizer. 'openai' / 'gemini' upgrade to real voices when a key is set.
AETHERIS_SPEECH_ENABLED=true
AETHERIS_SPEECH_PROVIDER=offline
AETHERIS_SPEECH_MODEL=tts-1
AETHERIS_SPEECH_VOICE=alloy
# Speech-to-text: offline has no speech-recognition model and returns an honest
# "not available offline" result. Set 'openai' (Whisper) or 'gemini' for real
# transcription.
AETHERIS_STT_ENABLED=true
AETHERIS_STT_PROVIDER=offline
AETHERIS_STT_MODEL=whisper-1

# --- Anthropic (Claude) & Google Gemini chat providers ----------------------
# Used when AETHERIS_LLM_PROVIDER=anthropic / =gemini (adds to the existing
# hermes / openai / mock / neural options).
AETHERIS_ANTHROPIC_API_KEY=
AETHERIS_ANTHROPIC_MODEL=claude-sonnet-4-20250514
AETHERIS_ANTHROPIC_BASE_URL=https://api.anthropic.com
AETHERIS_GEMINI_API_KEY=
AETHERIS_GEMINI_MODEL=gemini-2.5-flash
AETHERIS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ============================================================================
# Security & Operations
# ============================================================================

# --- API Key Authentication (OFF by default) --------------------------------
# When enabled, all /v1/* endpoints (except /v1/health and /) require a valid
# API key in the Authorization: Bearer <key> or X-API-Key header.
AETHERIS_AUTH_ENABLED=false
# A single API key (or use AETHERIS_AUTH_API_KEYS for multiple).
AETHERIS_AUTH_API_KEY=
# Comma-separated list of accepted API keys.
AETHERIS_AUTH_API_KEYS=
# Per-client token quota (0 = unlimited).
AETHERIS_AUTH_TOKEN_QUOTA=1000000

# --- Rate limiting -----------------------------------------------------------
AETHERIS_RATE_LIMIT_ENABLED=true
# Max requests per client in the sliding window.
AETHERIS_RATE_LIMIT_REQUESTS=60
# Sliding window duration in seconds.
AETHERIS_RATE_LIMIT_WINDOW_SECONDS=60
# Additional burst allowance.
AETHERIS_RATE_LIMIT_BURST=10

# --- Security headers --------------------------------------------------------
# Inject standard security headers (X-Content-Type-Options, X-Frame-Options,
# Referrer-Policy, Permissions-Policy, etc.) into every response.
AETHERIS_SECURITY_HEADERS_ENABLED=true
# Content-Security-Policy header (empty = no CSP).
AETHERIS_SECURITY_CSP=
# Strict-Transport-Security max-age (0 = no HSTS).
AETHERIS_SECURITY_HSTS_MAX_AGE=0
AETHERIS_SECURITY_HSTS_INCLUDE_SUBDOMAINS=false

# --- Request size limit ------------------------------------------------------
# Maximum request body size in bytes (default 10 MB).
AETHERIS_MAX_REQUEST_SIZE_BYTES=10485760

# --- Audit logging -----------------------------------------------------------
AETHERIS_AUDIT_ENABLED=true
AETHERIS_AUDIT_MAX_ENTRIES=10000

# --- Content filtering -------------------------------------------------------
# Scan inputs for PII and prompt-injection patterns.
AETHERIS_CONTENT_FILTER_ENABLED=true
# Automatically redact detected PII (emails, SSNs, credit cards, etc.).
AETHERIS_CONTENT_FILTER_REDACT_PII=true
# Block requests matching prompt-injection patterns (vs. just logging).
AETHERIS_CONTENT_FILTER_BLOCK_INJECTION=false

# --- CORS configuration ------------------------------------------------------
# Comma-separated allowed origins (empty = allow all origins for dev/preview).
# Production example: "https://aetheris.example.com,https://app.example.com"
AETHERIS_CORS_ORIGINS=
AETHERIS_CORS_ALLOW_CREDENTIALS=false
AETHERIS_CORS_METHODS=
AETHERIS_CORS_HEADERS=

# ============================================================================
# Automation & Integration
# ============================================================================

# --- Workflow engine ----------------------------------------------------------
AETHERIS_AUTOMATIONS_ENABLED=true
AETHERIS_WORKFLOW_MAX_STEPS=50
AETHERIS_MAX_CONNECTIONS=100
AETHERIS_MAX_WORKFLOWS=200

# --- Scheduler ----------------------------------------------------------------
# Auto-start the cron scheduler on server startup.
AETHERIS_SCHEDULER_ENABLED=false
AETHERIS_SCHEDULER_TICK_SECONDS=30

# ============================================================================
# Extra Features (v0.4.0)
# ============================================================================

# --- Response cache ----------------------------------------------------------
AETHERIS_CACHE_ENABLED=true
# Default TTL for cached responses (seconds).
AETHERIS_CACHE_DEFAULT_TTL=300
# Maximum number of cached entries (LRU eviction when full).
AETHERIS_CACHE_MAX_ENTRIES=1000

# --- File storage ------------------------------------------------------------
AETHERIS_FILE_STORAGE_ENABLED=true
# Maximum number of stored files.
AETHERIS_FILE_MAX_COUNT=500
# Maximum size per file in bytes (default 50 MB).
AETHERIS_FILE_MAX_SIZE_BYTES=52428800

# --- Plugin system -----------------------------------------------------------
AETHERIS_PLUGINS_ENABLED=true
# Maximum number of registered plugins.
AETHERIS_PLUGINS_MAX=50

# --- Analytics ----------------------------------------------------------------
AETHERIS_ANALYTICS_ENABLED=true
# Maximum analytics records retained.
AETHERIS_ANALYTICS_MAX_RECORDS=50000

# --- Presets ------------------------------------------------------------------
AETHERIS_PRESETS_ENABLED=true
# Maximum stored presets.
AETHERIS_PRESETS_MAX=100

# --- Bookmarks ----------------------------------------------------------------
AETHERIS_BOOKMARKS_ENABLED=true
# Maximum bookmarks.
AETHERIS_BOOKMARKS_MAX=1000

# --- Notifications ------------------------------------------------------------
AETHERIS_NOTIFICATIONS_ENABLED=true
# Maximum notifications retained.
AETHERIS_NOTIFICATIONS_MAX=5000

# --- Snapshots ----------------------------------------------------------------
AETHERIS_SNAPSHOTS_ENABLED=true
# Maximum snapshots retained.
AETHERIS_SNAPSHOTS_MAX=500

# ============================================================================
# Extra Features (v0.6.0)
# ============================================================================

# --- Feature flags ------------------------------------------------------------
AETHERIS_FEATURE_FLAGS_ENABLED=true
# Maximum feature flags.
AETHERIS_FEATURE_FLAGS_MAX=200

# --- API key management -------------------------------------------------------
AETHERIS_API_KEY_MANAGEMENT_ENABLED=true
# Maximum managed API keys.
AETHERIS_API_KEYS_MAX=100

# --- Playground history -------------------------------------------------------
AETHERIS_PLAYGROUND_ENABLED=true
# Maximum playground history entries.
AETHERIS_PLAYGROUND_MAX_ENTRIES=10000

# --- Batch operations ---------------------------------------------------------
AETHERIS_BATCH_ENABLED=true

# --- Activity timeline --------------------------------------------------------
AETHERIS_ACTIVITY_LOG_ENABLED=true
# Maximum activity entries retained.
AETHERIS_ACTIVITY_LOG_MAX_ENTRIES=20000

# --- Custom fields ------------------------------------------------------------
AETHERIS_CUSTOM_FIELDS_ENABLED=true
# Maximum field definitions.
AETHERIS_CUSTOM_FIELDS_MAX=500

# ============================================================================
# Extra Features (v0.7.0)
# ============================================================================

# --- Tags & taxonomy ----------------------------------------------------------
AETHERIS_TAGS_ENABLED=true
# Maximum tag assignments.
AETHERIS_TAGS_MAX_ASSIGNMENTS=50000

# --- Health probes ------------------------------------------------------------
AETHERIS_HEALTH_PROBES_ENABLED=true

# --- Usage quotas -------------------------------------------------------------
AETHERIS_QUOTAS_ENABLED=true

# --- Command palette ----------------------------------------------------------
AETHERIS_COMMANDS_ENABLED=true
# Maximum registered commands.
AETHERIS_COMMANDS_MAX=200

# --- Sharing ------------------------------------------------------------------
AETHERIS_SHARING_ENABLED=true
# Maximum shares.
AETHERIS_SHARING_MAX=1000

# --- Changelog ----------------------------------------------------------------
AETHERIS_CHANGELOG_ENABLED=true
# Maximum changelog entries.
AETHERIS_CHANGELOG_MAX_ENTRIES=5000

# ============================================================================
# Ætheris NOVA (next-gen architecture)
# ============================================================================
AETHERIS_NOVA_ENABLED=true
AETHERIS_NOVA_MEMORY_RECALL_MAX=50000
AETHERIS_NOVA_MEMORY_ARCHIVAL_MAX=200000
AETHERIS_NOVA_MOE_TOP_K=2
AETHERIS_NOVA_ORCHESTRATOR_MAX_ROUNDS=6
AETHERIS_NOVA_RESEARCH_MAX_SEARCHES=8
AETHERIS_NOVA_COMPUTER_USE_CONFIRM_REQUIRED=true

# ============================================================================
# Extra Features (v0.10.0)
# ============================================================================

# --- Cost tracking -----------------------------------------------------------
AETHERIS_COST_TRACKING_ENABLED=true
AETHERIS_COST_TRACKING_MAX_ENTRIES=100000

# --- Autosave drafts ---------------------------------------------------------
AETHERIS_DRAFTS_ENABLED=true
AETHERIS_DRAFTS_MAX=1000
AETHERIS_DRAFTS_MAX_REVISIONS=50

# --- Keyboard shortcuts / keybinding profiles -------------------------------
AETHERIS_SHORTCUTS_ENABLED=true
AETHERIS_SHORTCUTS_MAX_PROFILES=50

# --- Inline comments / annotation threads -----------------------------------
AETHERIS_COMMENTS_ENABLED=true
AETHERIS_COMMENTS_MAX=20000

# --- Recurring schedules / cron-like tasks ----------------------------------
AETHERIS_RECURRENCE_ENABLED=true
AETHERIS_RECURRENCE_MAX_TASKS=1000

# --- Embeddings & vector search ---------------------------------------------
AETHERIS_EMBEDDINGS_ENABLED=true
AETHERIS_EMBEDDINGS_DIMENSION=384
AETHERIS_EMBEDDINGS_MAX_DOCS=100000

# ===========================================================================
# Extra Features (v0.12.0) — Apex cognition
# ===========================================================================

# Typed entity-relation knowledge graph (Graph RAG, multi-hop).
AETHERIS_KNOWLEDGE_GRAPH_ENABLED=true
AETHERIS_KNOWLEDGE_GRAPH_MAX_NODES=20000

# Constitutional critique / revise / refuse.
AETHERIS_CONSTITUTION_ENABLED=true

# Evaluation harness (suites, graders, A/B).
AETHERIS_EVALS_ENABLED=true

# Sentence-level citation / provenance graphs.
AETHERIS_PROVENANCE_ENABLED=true

# Per-tool / per-provider circuit breakers.
AETHERIS_CIRCUIT_BREAKERS_ENABLED=true

# Composable skill matching.
AETHERIS_SKILLS_ENABLED=true

# Embedding-similarity response cache.
AETHERIS_SEMANTIC_CACHE_ENABLED=true
AETHERIS_SEMANTIC_CACHE_THRESHOLD=0.82

# JSON Schema contracts + repair.
AETHERIS_GUARDRAILS_ENABLED=true

# ===========================================================================
# Extra Features (v0.13.0) — God Mode
# ===========================================================================

# Fused meta-controller (ToT + causal + hypothesis + proof + red-team + forecast).
AETHERIS_GOD_MODE_ENABLED=true

# Tree-of-Thought UCB1 search.
AETHERIS_TOT_ENABLED=true

# Causal world model with do() / counterfactuals.
AETHERIS_WORLD_MODEL_ENABLED=true

# Bayesian hypothesis engine.
AETHERIS_HYPOTHESIS_ENABLED=true

# Natural-deduction proof kernel.
AETHERIS_PROOF_KERNEL_ENABLED=true

# Constitution red-team battery.
AETHERIS_REDTEAM_ENABLED=true

# Calibrated forecasting (Brier + 10 buckets).
AETHERIS_FORECAST_ENABLED=true
