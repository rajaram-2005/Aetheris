# ---------------------------------------------------------------------------
# Aetheris One — provider mesh keys
# Copy to .env.local and fill in whichever you have. Any subset works; the router
# only uses providers whose key is present. Priority 1 providers are tried first.
# ---------------------------------------------------------------------------

# Priority 1 — fast, generous free tiers
GROQ_API_KEY=                 # https://console.groq.com/keys
CEREBRAS_API_KEY=             # https://cloud.cerebras.ai
SAMBANOVA_API_KEY=            # https://cloud.sambanova.ai
GEMINI_API_KEY=               # https://aistudio.google.com/apikey

# Priority 2
GITHUB_MODELS_TOKEN=          # GitHub PAT with models:read — https://github.com/settings/tokens
OPENROUTER_API_KEY=           # https://openrouter.ai/keys
MISTRAL_API_KEY=              # https://console.mistral.ai
TOGETHER_API_KEY=             # https://api.together.ai
COHERE_API_KEY=               # https://dashboard.cohere.com/api-keys
CLOUDFLARE_API_TOKEN=         # https://dash.cloudflare.com/profile/api-tokens (Workers AI: Read)
CLOUDFLARE_ACCOUNT_ID=
HF_TOKEN=                     # https://huggingface.co/settings/tokens

# Priority 3+ — all free, no card (links open the key page)
MODELSCOPE_API_KEY=           # https://modelscope.cn/my/myaccesstoken     (2,000 req/day, 59 models)
OVH_AI_ENDPOINTS_TOKEN=       # https://www.ovhcloud.com/en/public-cloud/ai-endpoints/
OLLAMA_API_KEY=               # https://ollama.com/settings/keys
KILO_API_KEY=                 # https://kilo.ai
ZAI_API_KEY=                  # https://open.bigmodel.cn/usercenter/apikeys (GLM-4-Flash free)
SILICONFLOW_API_KEY=          # https://cloud.siliconflow.cn/account/ak
NEBIUS_API_KEY=               # https://studio.nebius.com/settings/api-keys
CHUTES_API_KEY=               # https://chutes.ai
GLHF_API_KEY=                 # https://glhf.chat
NSCALE_API_KEY=               # https://console.nscale.com
NVIDIA_API_KEY=               # https://build.nvidia.com
DEEPSEEK_API_KEY=             # https://platform.deepseek.com
AI21_API_KEY=                 # https://studio.ai21.com
PERPLEXITY_API_KEY=           # https://www.perplexity.ai/settings/api

# Keyless community endpoints (Pollinations, LLM7) work with NO key at all.
# Optional tokens raise their rate limits:
POLLINATIONS_API_KEY=         # https://auth.pollinations.ai
LLM7_API_KEY=                 # https://token.llm7.io

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Override a provider's default model: AETHERIS_MODEL_<PROVIDER_ID>
# AETHERIS_MODEL_GROQ=llama-3.1-8b-instant
# AETHERIS_MODEL_GEMINI=gemini-2.5-flash

# Seconds a provider is skipped after a rate limit / 5xx (default 60000 ms)
# AETHERIS_COOLDOWN_MS=60000
# Per-provider request timeout (default 45000 ms)
# AETHERIS_PROVIDER_TIMEOUT_MS=45000
# AETHERIS_SYSTEM_PROMPT="You are Aetheris One..."

# Vision model override per provider (used when the message has images)
# AETHERIS_VISION_MODEL_GROQ=meta-llama/llama-4-scout-17b-16e-instruct

# Web search grounding + Deep Research (server-wide default; users can also BYOK in Settings)
# Free: 1,000 searches/month — https://app.tavily.com
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Phase 2 — GitHub Coding Factory
# ---------------------------------------------------------------------------
# Required in production: encrypts the GitHub token cookie (any long random string)
#   openssl rand -hex 32
AETHERIS_SECRET=

# GitHub OAuth App (https://github.com/settings/developers → New OAuth App)
#   Homepage URL:            http://localhost:3000
#   Authorization callback:  http://localhost:3000/api/auth/github/callback
# If omitted, users can still connect by pasting a PAT (scopes: repo, workflow).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Name of the private repo created in the user's account for factory runs
# AETHERIS_FACTORY_REPO=aetheris-factory

# ---------------------------------------------------------------------------
# Phase 3 — Multimodal Cloud Studio (all optional; users can also BYOK in the UI)
# ---------------------------------------------------------------------------
# Image: HF_TOKEN (FLUX.1-schnell), FAL_KEY, CLOUDFLARE_API_TOKEN+ACCOUNT_ID (SDXL Lightning)
FAL_KEY=
# Speech: ELEVENLABS_API_KEY (+ optional ELEVENLABS_VOICE_ID), HF_TOKEN (Kokoro Space)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# KOKORO_SPACE_URL=https://hexgrad-kokoro-tts.hf.space
# Video (Pro feature; BYOK also unlocks it)
LUMA_API_KEY=
RUNWAY_API_KEY=

# ---------------------------------------------------------------------------
# Phase 5 — UPI monetisation
# ---------------------------------------------------------------------------
# Admin key for /admin (approve/reject payments):  openssl rand -hex 24
AETHERIS_ADMIN_KEY=
# Payee shown in the UPI QR (defaults: 9488407998@upi / Rajaram)
# AETHERIS_UPI_VPA=9488407998@upi
# AETHERIS_UPI_NAME=Rajaram
# Free-tier chat messages per day (default 50)
# AETHERIS_FREE_DAILY_MESSAGES  # Free plan credits/day (paid plans: Lite 300, Pro 1000, Pro Max 4000, God unlimited)
#AETHERIS_FREE_DAILY_MESSAGES=50
# Where JSON data (payments, entitlements, usage) is stored (default ./data)
# AETHERIS_DATA_DIR=./data

# ── Sign in (all optional; email/phone OTP print a dev code to the console when unset) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth app (also used by the Coding Factory): GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET above
RESEND_API_KEY=
AUTH_EMAIL_FROM="Aetheris <login@yourdomain.com>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# or, for India: MSG91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
