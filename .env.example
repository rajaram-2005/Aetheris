# ---------------------------------------------------------------------------
# Aetheris One — provider mesh keys
# Copy to .env.local and fill in whichever you have. Any subset works; the router
# only uses providers whose key is present. Priority 1 providers are tried first.
# ---------------------------------------------------------------------------

# Priority 1 — fast, generous free tiers
GROQ_API_KEY=                 # https://console.groq.com/keys
CEREBRAS_API_KEY=             # https://cloud.cerebras.ai
SAMBANOVA_API_KEY=            # https://cloud.sambanova.ai
GEMINI_API_KEY=               # https://aistudio.google.com/apikey

# Priority 2
GITHUB_MODELS_TOKEN=          # GitHub PAT with models:read — https://github.com/settings/tokens
OPENROUTER_API_KEY=           # https://openrouter.ai/keys
MISTRAL_API_KEY=              # https://console.mistral.ai
TOGETHER_API_KEY=             # https://api.together.ai
COHERE_API_KEY=               # https://dashboard.cohere.com/api-keys
CLOUDFLARE_API_TOKEN=         # https://dash.cloudflare.com/profile/api-tokens (Workers AI: Read)
CLOUDFLARE_ACCOUNT_ID=
HF_TOKEN=                     # https://huggingface.co/settings/tokens

# Priority 3+ — all free, no card (links open the key page)
MODELSCOPE_API_KEY=           # https://modelscope.cn/my/myaccesstoken     (2,000 req/day, 59 models)
OVH_AI_ENDPOINTS_TOKEN=       # https://www.ovhcloud.com/en/public-cloud/ai-endpoints/
OLLAMA_API_KEY=               # https://ollama.com/settings/keys
KILO_API_KEY=                 # https://kilo.ai
ZAI_API_KEY=                  # https://open.bigmodel.cn/usercenter/apikeys (GLM-4-Flash free)
SILICONFLOW_API_KEY=          # https://cloud.siliconflow.cn/account/ak
NEBIUS_API_KEY=               # https://studio.nebius.com/settings/api-keys
CHUTES_API_KEY=               # https://chutes.ai
GLHF_API_KEY=                 # https://glhf.chat
NSCALE_API_KEY=               # https://console.nscale.com
NVIDIA_API_KEY=               # https://build.nvidia.com
DEEPSEEK_API_KEY=             # https://platform.deepseek.com
AI21_API_KEY=                 # https://studio.ai21.com
PERPLEXITY_API_KEY=           # https://www.perplexity.ai/settings/api

# Keyless community endpoints (Pollinations, LLM7) work with NO key at all.
# Optional tokens raise their rate limits:
POLLINATIONS_API_KEY=         # https://auth.pollinations.ai
LLM7_API_KEY=                 # https://token.llm7.io

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Override a provider's default model: AETHERIS_MODEL_<PROVIDER_ID>
# AETHERIS_MODEL_GROQ=llama-3.1-8b-instant
# AETHERIS_MODEL_GEMINI=gemini-2.5-flash

# Local / self-hosted inference (optional). These servers speak the OpenAI-compatible
# /v1/chat/completions protocol. Set exactly one local flag to activate it.
# OLLAMA_LOCAL=1
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.1
# LMSTUDIO_LOCAL=1
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_MODEL=local-model
# CUSTOM_LLM_BASE_URL=http://127.0.0.1:8000/v1
# CUSTOM_LLM_MODEL=default
# CUSTOM_LLM_API_KEY=local

# Development-only honest response when every provider fails before connecting. The response is
# labelled "offline-preview" and is not an AI answer. Production keeps failing closed by default.
# AETHERIS_OFFLINE_FALLBACK=0

# Seconds a provider is skipped after a rate limit / 5xx (default 60000 ms)
# AETHERIS_COOLDOWN_MS=60000
# Per-provider request timeout (default 45000 ms)
# AETHERIS_PROVIDER_TIMEOUT_MS=45000
# AETHERIS_SYSTEM_PROMPT="You are Aetheris One..."

# Vision model override per provider (used when the message has images)
# AETHERIS_VISION_MODEL_GROQ=meta-llama/llama-4-scout-17b-16e-instruct

# Web search grounding + Deep Research (server-wide default; users can also BYOK in Settings)
# Free: 1,000 searches/month — https://app.tavily.com
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Phase 2 — GitHub Coding Factory
# ---------------------------------------------------------------------------
# Set a stable local secret when using encrypted credentials or OAuth integrations
#   openssl rand -hex 32
AETHERIS_SECRET=

# GitHub OAuth App (https://github.com/settings/developers → New OAuth App)
#   Homepage URL:            http://localhost:3000
#   Authorization callback:  http://localhost:3000/api/auth/github/callback
# If omitted, users can still connect by pasting a PAT (scopes: repo, workflow).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Name of the private repo created in the user's account for factory runs
# AETHERIS_FACTORY_REPO=aetheris-factory

# ---------------------------------------------------------------------------
# Phase 3 — Multimodal Cloud Studio (all optional; users can also BYOK in the UI)
# ---------------------------------------------------------------------------
# Image: HF_TOKEN (FLUX.1-schnell), FAL_KEY, CLOUDFLARE_API_TOKEN+ACCOUNT_ID (SDXL Lightning)
FAL_KEY=
# Speech: ELEVENLABS_API_KEY (+ optional ELEVENLABS_VOICE_ID), HF_TOKEN (Kokoro Space)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# KOKORO_SPACE_URL=https://hexgrad-kokoro-tts.hf.space
# Video (Pro feature; BYOK also unlocks it)
LUMA_API_KEY=
RUNWAY_API_KEY=

# ---------------------------------------------------------------------------
# Phase 5 — UPI monetisation
# ---------------------------------------------------------------------------
# Admin key for /admin (approve/reject payments):  openssl rand -hex 24
AETHERIS_ADMIN_KEY=
# Payee shown in the UPI QR (defaults: 9488407998@upi / Rajaram)
# AETHERIS_UPI_VPA=9488407998@upi
# AETHERIS_UPI_NAME=Rajaram
# Free-tier chat messages per day (default 50)
# AETHERIS_FREE_DAILY_MESSAGES  # Free plan credits/day (paid plans: Lite 300, Pro 1000, Pro Max 4000, God unlimited)
#AETHERIS_FREE_DAILY_MESSAGES=50
# Where JSON data (payments, entitlements, usage) is stored (default ./data)
# AETHERIS_DATA_DIR=./data

# ── Anonymous web workspace ───────────────────────────────────────────────────
# The web app opens directly to Chat. No login or display name is required.
# These legacy auth switches are intentionally disabled; leave them at 0.
AETHERIS_REQUIRE_AUTH=0
AETHERIS_GUEST_ACCESS=0
# Optional OAuth integrations use the exact local origin you open in the browser:
#   http://localhost:3000/api/auth/google/callback
#   http://localhost:3000/api/auth/github/callback
# Desktop: use the actual embedded loopback origin/port. See docs/AUTHENTICATION.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth app (also used by the Coding Factory): GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET above

# Optional scheduled-email delivery (not used for login)
RESEND_API_KEY=
AUTH_EMAIL_FROM="Aetheris <notifications@yourdomain.com>"

# Billing is OFF by default — Aetheris is free for everyone (all features, no limits).
# Leave unset or 0 for local use; the legacy plan / UPI system is not required.
# AETHERIS_PAID_PLANS=1

# Admin accounts: anyone signing in with these emails/phones gets full access (God Mode, no metering, /admin).
AETHERIS_ADMIN_EMAILS=ramkpraja175@gmail.com
AETHERIS_ADMIN_PHONES=+919488407998

# ---- Scheduled automations ----
# Optional: protects GET/POST /api/schedules/tick when called from a local cron job.
CRON_SECRET=
# Set to 0 to disable the in-process minute ticker. Schedules require the local app to stay running.
AETHERIS_SCHEDULER=

# ---- Intelligence OS core ----
# Comma-separated uids that get full_workspace + admin grants (see Control Center → Overview for your uid). Physical is never granted here.
AETHERIS_ADMIN_UIDS=
# Size of the in-memory observability ring buffer (default 5000 events).
AETHERIS_EVENT_BUFFER=
# SQLite file for the knowledge fabric (default <AETHERIS_DATA_DIR>/knowledge.sqlite)
AETHERIS_KNOWLEDGE_DB=
# Set to 1 to let MCP/automation/device/browser adapters reach private/LAN addresses (default: blocked, SSRF guard).
AETHERIS_ALLOW_PRIVATE_URLS=
# Model routing: local = local providers only; prefer_local = local first with online fallback.
# remote = online providers only; any / unset = default order. Does not disable online integrations.
AETHERIS_LOCALITY=

# ---- Neurosymbolic / Edge / Lab / PBNN / DEMO (all opt-in) ----
# Where deployed lab scripts are written to. Defaults to <AETHERIS_DATA_DIR>/lab/deployed.
# The host Aetheris process is never modified; the agent can only write to this directory.
# AETHERIS_LAB_DEPLOY_DIR=/absolute/path/to/lab/deployed
#
# Allow the lab to use the docker runtime (in addition to the always-on server sandbox).
# Off by default. When on, each lab request still requires a confirmation token.
# AETHERIS_LAB_DOCKER_ENABLED=1
#
# Deterministic DEMO mode: seeds a fixed user (demo-user), 3 chats, 3 projects, 1 twin, diagnostic history
# AETHERIS_DEMO=1
# AETHERIS_DEMO_PROVIDER=groq

# ---- Hosted / Vercel (all optional; local file backends stay the default) ----
# Store backend: files (default, data/*.json) or postgres (hosted, e.g. Neon).
# AETHERIS_STORE=postgres
# Pooled connection string (Vercel Marketplace wires POSTGRES_URL automatically).
# POSTGRES_URL=postgres://user:pass@host/db?sslmode=require
# Knowledge fabric backend: sqlite (default, data/knowledge.sqlite) or postgres (hosted).
# AETHERIS_KNOWLEDGE=postgres
